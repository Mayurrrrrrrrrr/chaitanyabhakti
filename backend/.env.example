# Vaishnav Bhakti App - Backend Environment Variables

# Server Configuration
NODE_ENV=production
PORT=10000

# Database Configuration (Render PostgreSQL)
DB_HOST=[from Render dashboard]
DB_PORT=[from Render dashboard]
DB_NAME=vaishnav_bhakti
DB_USER=[from Render dashboard]
DB_PASSWORD=[from Render dashboard]

# JWT Configuration
JWT_SECRET=[generate secure random string]

# Frontend URL for CORS
CLIENT_URL=https://chaitanyabhakti.vercel.app

# Backend URL
BACKEND_URL=https://chaitanyabhakti.onrender.com